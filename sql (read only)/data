  'Business',
  1 + ((CAST(SUBSTRING(b.booking_id,3) AS UNSIGNED) + 1) MOD 4) AS row_num,
  1 + ((CAST(SUBSTRING(b.booking_id,3) AS UNSIGNED) + 3) MOD 6) AS column_number
FROM Booking b
JOIN Flight f ON f.flight_number = b.flight_number
